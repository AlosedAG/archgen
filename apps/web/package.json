{
  "name": "archscope-web",
  "version": "0.1.0",
  "private": true,
  "description": "ArchitectureScope web app (Next.js) — the platform rebuild's front end, over the FastAPI service.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../api/openapi.json --output src/lib/api-types.ts",
    "check:api": "openapi-typescript ../api/openapi.json --output src/lib/api-types.ts --check"
  },
  "dependencies": {
    "docx": "9.10.0",
    "framer-motion": "^14.1.0",
    "jspdf": "4.2.1",
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
