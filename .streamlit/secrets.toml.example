# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud → App settings → Secrets. Never commit the real file.

# --- API keys (Community Cloud exports top-level keys as environment variables) ---
HUBSPOT_TOKEN = ""
ANTHROPIC_API_KEY = ""

# --- Google sign-in (optional; remove this section to disable) ---
[auth]
redirect_uri = "https://YOUR-APP-NAME.streamlit.app/oauth2callback"  # local: http://localhost:8501/oauth2callback
cookie_secret = "PASTE-A-LONG-RANDOM-STRING"  # python -c "import secrets; print(secrets.token_hex(32))"
client_id = "XXXXXXXX.apps.googleusercontent.com"
client_secret = "GOCSPX-XXXXXXXX"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Who may sign in with Google (required when [auth] is set — nobody is allowed otherwise).
[access]
allowed_emails = ["you@gmail.com"]
allowed_domains = []  # e.g. ["sonamation.com"] lets anyone @sonamation.com in

# --- Username + password sign-in (optional; remove this section to disable) ---
# Values can be plain text, but prefer a hash: python -m core.auth
[passwords]
aylin = "pbkdf2_sha256$600000$...$..."

# --- In-app Feedback button (optional; without it the button tells users to email instead) ---
# Feedback is emailed from this mailbox to `to`. For Google Workspace / Gmail:
#   1. Turn on 2-Step Verification for the sending account.
#   2. Create an App Password: myaccount.google.com → Security → App passwords.
#   3. Paste the 16-character app password below (not your normal password).
[feedback]
smtp_host = "smtp.gmail.com"
smtp_port = 587                       # 465 also works (implicit TLS)
smtp_username = "aylin@sonamation.com"
smtp_password = "PASTE-16-CHAR-APP-PASSWORD"
to = "aylin@sonamation.com"           # who receives the feedback
# from = "aylin@sonamation.com"       # defaults to smtp_username
